; Engine configuration file.
; It's best edited using the editor UI and not directly,
; however this file is maintained in git for reproducibility.

[application]

config/name="Wayfarer"
config/version="0.1.0"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/art/icon.svg"
run/main_scene="res://scenes/world/main.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[autoload]

GameState="*res://scripts/system/game_state.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/srd/plugin.cfg")

