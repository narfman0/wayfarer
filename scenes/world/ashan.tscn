[node name="Amma" type="Node3D" parent="Level"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6, 0, 2)
script = ExtResource("9_npc")
npc_display_name = "Amma"
feminine = true
bark_lines = Array[String](["Fruit is heaviest the week before you leave. It always knows.", "Sit if you like. The light does the talking here.", "Nobody hurries in Ashan. It never once helped."])
wander_points = Array[NodePath]([NodePath("../Strolls/SA1"), NodePath("../Strolls/SA2")])

[node name="Skin" parent="Level/Amma" instance=ExtResource("c_npc_f")]

[node name="Toma" type="Node3D" parent="Level"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 8, 0, -2)
script = ExtResource("9_npc")
npc_display_name = "Toma"
bark_lines = Array[String](["Your sister mended that fence, third post from the gate.", "The tear here never took a thing from us. Some don't.", "Stay for the evening bell. Everyone does, once."])
wander_points = Array[NodePath]([NodePath("../Strolls/SB1"), NodePath("../Strolls/SB2")])

[node name="Skin" parent="Level/Toma" instance=ExtResource("c_npc_m")]

[node name="Old_Vess" type="Node3D" parent="Level"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -10, 0, -6)
script = ExtResource("9_npc")
npc_display_name = "Old Vess"
bark_lines = Array[String](["I crossed nine planes to stop crossing planes. Best trade I made.", "The Veil hums low here. Like a kept hive.", "You have the look of a man mid-errand. Ashan is where errands end."])
wander_points = Array[NodePath]([NodePath("../Strolls/SC1"), NodePath("../Strolls/SC2")])

[node name="Skin" parent="Level/Old_Vess" instance=ExtResource("c_npc_m")]

[node name="Mirei" type="Node3D" parent="Level"]
transform = Transform3D(0.5, 0, 0.866, 0, 1, 0, -0.866, 0, 0.5, 6, 0, 3)
script = ExtResource("9_npc")
npc_display_name = "Mirei"
feminine = true
bark_lines = Array[String](["She talked about you. The brother with the maps in his head.", "Harvest first. Grief after. That is the order that works.", "The kettle is always on at the third house. That is a rule."])

